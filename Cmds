-- ================================================================
--  TOGGLE / MINIMIZE / CLOSE
-- ================================================================
local visible, min = true, false
local FULL = UDim2.new(0, 360, 0, 420)
local MIN = UDim2.new(0, 360, 0, 46)

local function toggle()
    visible = not visible
    if visible then
        SG.Enabled = true; min = false
        MN.Text = "−"; CT.Visible = true
        CF.Size = UDim2.new(0, 0, 0, 0); CF.Position = UDim2.new(0.5, 0, 0.5, 0)
        CF.BackgroundTransparency = 1; c2.Transparency = 1
        TS:Create(CF, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = FULL, Position = UDim2.new(0.5, -180, 0.5, -210), BackgroundTransparency = 0.15,
        }):Play()
        TS:Create(c2, TweenInfo.new(0.35), {Transparency = 0.2}):Play()
    else
        local tw = TS:Create(CF, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1,
        })
        tw:Play(); TS:Create(c2, TweenInfo.new(0.25), {Transparency = 1}):Play()
        tw.Completed:Wait(); SG.Enabled = false
    end
end

W.toggles.cmds = toggle

