    min = not min
    if min then
        CT.Visible = false; MN.Text = "▢"
        TS:Create(CF, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = MIN}):Play()
    else
        CT.Visible = true; MN.Text = "■"
        TS:Create(CF, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = FULL}):Play()
    end
end)
