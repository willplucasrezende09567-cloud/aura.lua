local function makeCtrlBtn(text, color, xOffset)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 26, 0, 26)
    btn.Position = UDim2.new(1, xOffset, 0, 8)
    btn.BackgroundColor3 = C.btnIdle
    btn.BackgroundTransparency = 0.3
    btn.Text = text
    btn.TextSize = 15
    btn.TextColor3 = color
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = CF
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", btn)
    s.Thickness = 1.2
    s.Color = color
    s.Transparency = 0.35
    btn.MouseEnter:Connect(function()
        TS:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
        TS:Create(s, TweenInfo.new(0.2), {Transparency = 0.1}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TS:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play()
        TS:Create(s, TweenInfo.new(0.2), {Transparency = 0.35}):Play()
    end)
    return btn
end

