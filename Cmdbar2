local vis, min = true, false
local FULL = UDim2.new(0, 300, 0, 76)
local MIN = UDim2.new(0, 300, 0, 32)

local function toggle()
    vis = not vis
    SG.Enabled = vis
    if vis then
        min = false
        BD.Visible = true
        CBF.Size = FULL
        MB2.Text = "−"
        CBI.Text = ""
        task.wait(0.1)
        CBI:CaptureFocus()
    end
end

W.toggles.cmdbar2 = toggle

local function run()
    local t = CBI.Text
    if t and t:gsub("%s+", "") ~= "" then
        local full = ";" .. t
        if W.processCommand then W.processCommand(full) end
        CBI.Text = ""
    end
end

EB.MouseButton1Down:Connect(function()
    run()
    task.wait(0.05)
    if vis and not min then CBI:CaptureFocus() end
end)

CAS:BindAction("BlockEnterCmdBar2", function(name, state, input)
    if state == Enum.UserInputState.Begin then
        if vis and CBI:IsFocused() then
            run()
            task.wait(0.05)
            if vis and not min then CBI:CaptureFocus() end
            return Enum.ContextActionResult.Sink
        end
    end
    return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter)

CBI.FocusLost:Connect(function(ep)
    if ep then run() end
end)

MB2.MouseButton1Down:Connect(function()
    min = not min
    if min then
        BD.Visible = false
        CBF.Size = MIN
        MB2.Text = "+"
    else
        BD.Visible = true
        CBF.Size = FULL
        MB2.Text = "−"
        task.wait(0.05)
        CBI:CaptureFocus()
    end
end)

CB2.MouseButton1Down:Connect(function()
    if vis then vis = false; SG.Enabled = false end
end)

do
    local da, ds, di = false, nil, nil
    MB2.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then da = false end
    end)
    CB2.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then da = false end
    end)
    HD.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            da = true
            ds = CBF.Position
            di = i.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.Change and da then
                    local d = i.Position - di
                    CBF.Position = UDim2.new(ds.X.Scale, ds.X.Offset + d.X, ds.Y.Scale, ds.Y.Offset + d.Y)
                end
            end)
        end
    end)
    HD.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then da = false end
    end)
end

task.wait(0.1)
CBI:CaptureFocus()

print("[cmdbar2] Carregado")
