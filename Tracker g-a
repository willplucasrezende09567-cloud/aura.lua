task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.3)

        local totais = obterTotalGA()

        local liderNome = "---"
        local liderTotal = 0
        for nome, total in pairs(totais) do
            if total > liderTotal then
                liderTotal = total
                liderNome = nome
            end
        end

        local meuTotal = 0
        for nome, total in pairs(totais) do
            if ehMeuNome(nome) then
                meuTotal = total
                break
            end
        end

        LiderNome.Text   = liderNome
        LiderPontos.Text = liderTotal .. " G/A"
        VocePontos.Text  = meuTotal .. " G/A"

        local euSouLider = ehMeuNome(liderNome)

        if liderNome == "---" then
            StatusLabel.Text = "⏳ Aguardando dados..."
            StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        elseif euSouLider then
            StatusLabel.Text = "🏆 Você está em 1º lugar!"
            StatusLabel.TextColor3 = Colors.green
        else
            local distancia = liderTotal - meuTotal
            StatusLabel.Text = "📊 Faltam " .. distancia .. " G/A para o líder"
            StatusLabel.TextColor3 = Colors.gold
        end
    end
end)

