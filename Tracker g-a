local function ehMeuNome(nomeNoPlacar)
    if not nomeNoPlacar or nomeNoPlacar == "" then return false end
    local nomeLower = string.lower(nomeNoPlacar)

    if nomeLower == MEU_NOME_LOWER then return true end
    if nomeLower == MEU_DISPLAY_LOWER then return true end
    if #MEU_NOME_LOWER >= 4 and string.find(nomeLower, MEU_NOME_LOWER, 1, true) then return true end
    if #MEU_DISPLAY_LOWER >= 4 and string.find(nomeLower, MEU_DISPLAY_LOWER, 1, true) then return true end
    if #nomeLower >= 4 and string.find(MEU_NOME_LOWER, nomeLower, 1, true) then return true end
    if #nomeLower >= 4 and string.find(MEU_DISPLAY_LOWER, nomeLower, 1, true) then return true end

    return false
end

-- ================================================================
--  LÓGICA
-- ================================================================
local cachePlacas = { TopScorers = nil, TopAssists = nil }

local function encontrarPasta(nomeDaPasta)
    local boardsFolder = workspace:FindFirstChild("Boards")
    if boardsFolder then
        local pasta = boardsFolder:FindFirstChild(nomeDaPasta)
        if pasta then return pasta end
    end
    return workspace:FindFirstChild(nomeDaPasta, true)
end

local function obterTextLabels(nomeDaPasta)
    if cachePlacas[nomeDaPasta] and #cachePlacas[nomeDaPasta] > 0 then
        local aindaValido = true
        for _, lbl in ipairs(cachePlacas[nomeDaPasta]) do
            if not lbl.Parent then aindaValido = false break end
        end
        if aindaValido then return cachePlacas[nomeDaPasta] end
    end

    local pasta = encontrarPasta(nomeDaPasta)
    if not pasta then return {} end

    local textLabels = {}
    for _, obj in ipairs(pasta:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text ~= "" then
            table.insert(textLabels, obj)
        end
    end

    cachePlacas[nomeDaPasta] = textLabels
    return textLabels
end

local function extrairDadosDoPlacar(nomeDaPasta)
    local listaJogadores = {}
    local textLabels = obterTextLabels(nomeDaPasta)
    if #textLabels == 0 then return listaJogadores end

    local sortedLabels = {}
    for i, v in ipairs(textLabels) do sortedLabels[i] = v end

    table.sort(sortedLabels, function(a, b)
        local ay, by = a.AbsolutePosition.Y, b.AbsolutePosition.Y
        if math.abs(ay - by) < 15 then
            return a.AbsolutePosition.X < b.AbsolutePosition.X
        end
        return ay < by
    end)

    local linhas = {}
    for _, lbl in ipairs(sortedLabels) do
        local found = false
        for _, linha in ipairs(linhas) do
            if math.abs(linha.Y - lbl.AbsolutePosition.Y) < 15 then
                table.insert(linha.Textos, lbl.Text)
                found = true
                break
            end
        end
        if not found then
            table.insert(linhas, {Y = lbl.AbsolutePosition.Y, Textos = {lbl.Text}})
        end
    end

    for i, linha in ipairs(linhas) do
        local fullText = table.concat(linha.Textos, " ")
        local rank, name, score

        local r, n = string.match(fullText, "(%d+)%s+([%w_]+)")
        if r and n then rank = tonumber(r) name = n end

        local s = string.match(fullText, "(%d+)$")
        if s and name then score = tonumber(s) end

        if name then
            table.insert(listaJogadores, {rank = rank or (i), name = name, score = score or 0})
        end
    end
    return listaJogadores
end

local function obterTotalGA()
    local totalPorJogador = {}

    local topScorers = extrairDadosDoPlacar("TopScorers")
    for _, data in ipairs(topScorers) do
        totalPorJogador[data.name] = (totalPorJogador[data.name] or 0) + data.score
    end

    local topAssists = extrairDadosDoPlacar("TopAssists")
    for _, data in ipairs(topAssists) do
        totalPorJogador[data.name] = (totalPorJogador[data.name] or 0) + data.score
    end

    return totalPorJogador
end

-- ================================================================
--  LOOP PRINCIPAL
